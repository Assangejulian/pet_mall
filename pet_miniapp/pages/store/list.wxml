<view class="page">
  <!-- 地图区域 -->
  <view class="map-wrap" wx:if="{{showMap}}">
    <map
      id="storeMap"
      class="map"
      latitude="{{mapCenter.latitude}}"
      longitude="{{mapCenter.longitude}}"
      scale="14"
      markers="{{storeMarkers}}"
      bindmarkertap="onMarkerTap"
      show-location
    ></map>
  </view>

  <!-- 半径选择器 -->
  <view class="radius-bar">
    <text class="radius-label">搜索范围</text>
    <slider min="1" max="20" step="1" value="{{radius}}" show-value bindchange="changeRadius" />
    <text class="radius-val">{{radius}}km</text>
  </view>

  <!-- 视图切换 -->
  <view class="view-toggle">
    <text bindtap="toggleView">{{showMap ? '切换列表' : '切换地图'}}</text>
    <text class="store-count">其 {{stores.length}} 家门店</text>
  </view>

  <view class="error-tip" wx:if="{{errorText}}">
    <text>{{errorText}}</text>
  </view>

  <!-- 门店列表 -->
  <scroll-view class="store-list" scroll-y wx:if="{{!showMap || stores.length}}">
    <view class="card" wx:for="{{stores}}" wx:key="id" bindtap="onStoreTap" data-id="{{item.id}}">
      <view class="sr">
        <image class="si" src="{{item.image}}" mode="aspectFill" />
        <view class="sc">
          <text class="sn serif">{{item.storeName}}</text>
          <view class="sm">
            <text>⭐ {{item.rating}}</text>
            <text wx:if="{{item.distance}}">{{item.distance}}</text>
          </view>
          <text class="sa">{{item.address}}</text>
          <view class="st">
            <text class="tg" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="t">{{t}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 门店详情浮层 -->
  <view class="detail-mask" wx:if="{{detailVisible}}" bindtap="closeDetail"></view>
  <view class="detail-sheet" wx:if="{{detailVisible}}">
    <view class="ds-header">
      <text class="ds-name serif">{{selectedStore.storeName}}</text>
      <text class="ds-close" bindtap="closeDetail">✖</text>
    </view>
    <view class="ds-body">
      <view class="ds-row">
        <text class="ds-label">地址</text>
        <text class="ds-value">{{selectedStore.address}}</text>
      </view>
      <view class="ds-row" wx:if="{{selectedStore.storePhone}}">
        <text class="ds-label">电话</text>
        <text class="ds-value">{{selectedStore.storePhone}}</text>
      </view>
      <view class="ds-row" wx:if="{{selectedStore.distance}}">
        <text class="ds-label">距离</text>
        <text class="ds-value">{{selectedStore.distance}}</text>
      </view>
    </view>
    <view class="ds-actions">
      <button class="ds-btn primary" bindtap="navigateToStore">导航到此</button>
      <button class="ds-btn" bindtap="goStoreDetail">查看门店详情</button>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-tip" wx:if="{{!loading && !stores.length}}">
    <text>暂无附近门店</text>
  </view>
</view>
