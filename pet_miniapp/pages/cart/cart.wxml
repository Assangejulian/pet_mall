<view class="page">
  <!-- 未登录遮罩 -->
  <view class="login-mask" wx:if="{{!isLogin}}">
    <view class="login-mask-card">
      <view class="login-mask-icon"></view>
      <text class="login-mask-title">登录后查看购物车</text>
      <text class="login-mask-desc">登录后商品将同步到你的账号</text>
      <button class="login-mask-btn" bindtap="goLogin">去登录</button>
      <text class="login-mask-skip" bindtap="goHome">先去逛逛</text>
    </view>
  </view>

  <!-- 购物车内容（登录后可见） -->
  <view wx:elif="{{cart.length>0}}" class="list">
    <view wx:for="{{cart}}" wx:key="id" class="item">
      <view class="chk" bindtap="toggleCheck" data-id="{{item.id}}"><view class="dot {{item.checked?'on':''}}"></view></view>
      <image class="img" src="{{item.image}}" mode="aspectFill" />
      <view class="info">
        <text class="nm">{{item.name}}</text>
        <view class="row">
          <view class="price"><text class="price-symbol">¥</text>{{item.price}}</view>
          <view class="qty">
            <text class="b" bindtap="dec" data-id="{{item.id}}">-</text>
            <text class="n">{{item.quantity}}</text>
            <text class="b" bindtap="inc" data-id="{{item.id}}">+</text>
          </view>
        </view>
      </view>
      <text class="del" bindtap="del" data-id="{{item.id}}">x</text>
    </view>
  </view>
  <view class="empty-tip" wx:elif="{{cart.length===0}}">
    <text class="empty-icon">O</text>
    <text>购物车空空的</text>
    <text class="empty-sub">去暖窝逛逛吧</text>
    <button class="btn-accent" bindtap="goHome">去逛逛</button>
  </view>

  <view class="b-bar" wx:if="{{isLogin && cart.length>0}}">
    <view class="all" bindtap="toggleAll"><view class="dot {{allChecked?'on':''}}"></view><text>全选</text></view>
    <text class="sum">合计 <text class="sum-price">¥{{totalPrice}}</text></text>
    <view class="btn-accent btn-checkout" bindtap="checkout">结算({{checkedCount}})</view>
  </view>
</view>