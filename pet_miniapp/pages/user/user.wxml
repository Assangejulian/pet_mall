<view class="page">
  <!-- 未登录 -->
  <view class="login-mask" wx:if="{{!isLogin}}">
    <view class="login-mask-card">
      <view class="login-mask-icon"></view>
      <text class="login-mask-title">登录个人中心</text>
      <text class="login-mask-desc">登录后查看订单、收货地址等</text>
      <button class="login-mask-btn" bindtap="goLogin">去登录</button>
    </view>
  </view>

  <!-- 已登录 -->
  <view wx:else>
    <view class="profile" bindtap="goProfile">
      <view class="pf-bg"></view>
      <view class="pf-inner">
        <view class="pf-avatar" wx:if="{{avatar}}">
          <image class="pf-avatar-img" src="{{avatar}}" mode="aspectFill" />
        </view>
        <view class="pf-avatar" wx:else>{{userName[0]||'?'}}</view>
        <view class="pf-info">
          <text class="pf-name serif">{{userName||'用户'}}</text>
          <text class="pf-sub">{{memberLevelName || '暖窝会员'}}</text>
        </view>
        <text class="pf-arrow">></text>
      </view>
    </view>

    <view class="card">
      <text class="sec serif">我的订单</text>
      <view class="og">
        <view wx:for="{{tabs}}" wx:key="s" class="oi" bindtap="goOrders" data-s="{{item.s}}">
          <text class="oi-icon">{{item.i}}</text>
          <text class="oi-lb">{{item.l}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="mi" bindtap="goProfile"><text>个人资料</text><text class="ar">></text></view>
      <view class="mi" bindtap="goAddr"><text>收货地址</text><text class="ar">></text></view>
      <view class="mi" bindtap="goStores"><text>附近门店</text><text class="ar">></text></view>
      <view class="mi" bindtap="goVideos"><text>暖窝视频</text><text class="ar">></text></view>
    </view>

    <view class="card" bindtap="logout"><view class="mi logout-btn"><text>退出登录</text></view></view>
  </view>
</view>
