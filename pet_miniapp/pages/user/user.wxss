.page{padding:20rpx 28rpx 40rpx}.profile{position:relative;border-radius:18rpx;overflow:hidden;margin-bottom:24rpx}.pf-bg{height:180rpx;background:linear-gradient(135deg,#2d1f18,#4a3428)}.pf-inner{position:relative;z-index:1;display:flex;align-items:center;padding:30rpx 28rpx;margin-top:-40rpx}.pf-avatar{width:100rpx;height:100rpx;border-radius:50%;background:#e8927c;color:#fff;font-size:40rpx;font-weight:700;display:flex;align-items:center;justify-content:center;border:4rpx solid rgba(255,255,255,.4)}.pf-info{flex:1;margin-left:22rpx}.pf-name{display:block;font-size:34rpx;font-weight:700;color:#fff}.pf-sub{font-size:22rpx;color:rgba(255,255,255,.5)}.pf-btn{background:rgba(255,255,255,.18);padding:12rpx 28rpx;border-radius:20rpx;color:#fff;font-size:26rpx;font-weight:600}.sec{font-size:28rpx;font-weight:700;display:block;margin-bottom:22rpx}.og{display:flex;justify-content:space-around}.oi{display:flex;flex-direction:column;align-items:center;gap:8rpx}.oi-icon{font-size:40rpx;color:#e8927c}.oi-lb{font-size:22rpx;color:#8f7366}.mi{display:flex;justify-content:space-between;align-items:center;padding:22rpx 6rpx;border-bottom:1rpx solid rgba(140,104,83,.06);font-size:28rpx}.mi:last-child{border:none}.ar{color:rgba(140,104,83,.3);font-size:32rpx}
