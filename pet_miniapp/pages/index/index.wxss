.home {
  min-height: 100vh;
  padding: 28rpx 24rpx 34rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fbf6ed 0%, #fffaf4 52%, #f7efe4 100%);
}

/* ===== Hero ===== */
.hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}
.hero-text {
  flex: 1;
  min-width: 0;
}
.eyebrow {
  display: block;
  color: #e8927c;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}
.title {
  display: block;
  font-family: "Songti SC", serif;
  color: #0b4a3d;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.16;
}
.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #8f7366;
  font-size: 25rpx;
  line-height: 1.45;
}

/* ===== 搜索图标（头部右侧） ===== */
.hero-search {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(140, 104, 83, 0.12);
  box-shadow: 0 8rpx 24rpx rgba(75, 45, 28, 0.06);
  flex-shrink: 0;
  margin-top: 6rpx;
}
.hero-search:active {
  background: rgba(255, 255, 255, 0.5);
  transform: scale(0.92);
}
.hero-search .search-icon {
  font-size: 34rpx;
  color: #e8927c;
}

/* ===== Mock 提示 ===== */
.mock-tip {
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  color: #9d7a6b;
  background: rgba(232, 146, 124, 0.1);
  font-size: 23rpx;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}
.skeleton-col {
  flex: 1;
  min-width: 0;
}
.skeleton-card {
  width: 100%;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(140, 104, 83, 0.08);
  overflow: hidden;
  margin-bottom: 18rpx;
}
.skeleton-img {
  width: 100%;
  height: 260rpx;
  background: linear-gradient(90deg, #ede5db 25%, #f5efe8 50%, #ede5db 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
.skeleton-card.tall .skeleton-img { height: 340rpx; }
.skeleton-card.short .skeleton-img { height: 210rpx; }
.skeleton-card.medium .skeleton-img { height: 285rpx; }
.skeleton-body {
  padding: 16rpx 16rpx 18rpx;
}
.skeleton-line {
  height: 20rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #ede5db 25%, #f5efe8 50%, #ede5db 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 12rpx;
}
.skeleton-line.w-70 { width: 70%; }
.skeleton-line.w-90 { width: 90%; }
.skeleton-line.w-40 { width: 40%; }
.skeleton-line.w-60 { width: 60%; }
.skeleton-line.w-80 { width: 80%; }
.skeleton-line.w-65 { width: 65%; }
.skeleton-line.w-85 { width: 85%; }
.skeleton-line.w-45 { width: 45%; }
.skeleton-line.w-50 { width: 50%; }
.skeleton-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}
.skeleton-avatar {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #ede5db 25%, #f5efe8 50%, #ede5db 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== 瀑布流 ===== */
.waterfall {
  column-count: 2;
  column-gap: 18rpx;
}
.video-card {
  width: 100%;
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(140, 104, 83, 0.1);
  box-shadow: 0 18rpx 42rpx rgba(75, 45, 28, 0.08);
  break-inside: avoid;
  margin-bottom: 18rpx;
}
.cover {
  width: 100%;
  height: 260rpx;
  display: block;
}
.video-card.tall .cover { height: 340rpx; }
.video-card.medium .cover { height: 285rpx; }
.video-card.short .cover { height: 210rpx; }
.card-body {
  padding: 16rpx 16rpx 18rpx;
}
.video-title {
  display: block;
  color: #2d1f18;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.34;
}
.video-desc {
  display: -webkit-box;
  margin-top: 8rpx;
  color: #8f7366;
  font-size: 23rpx;
  line-height: 1.38;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.video-card.tall .video-desc,
.video-card.medium .video-desc {
  -webkit-line-clamp: 3;
}
.meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
}
.avatar {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.author {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9d7a6b;
  font-size: 21rpx;
}
.likes {
  flex-shrink: 0;
  color: #e8927c;
  font-size: 21rpx;
  font-weight: 700;
}

/* ===== 空状态 ===== */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #a58b7d;
  font-size: 26rpx;
  gap: 16rpx;
}
.empty-icon {
  font-size: 60rpx;
}