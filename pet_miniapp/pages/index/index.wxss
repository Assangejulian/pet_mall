.home { padding-bottom: 20rpx; background: #f5f5f5; }
.search-bar { padding: 16rpx 24rpx; background: #fff; }
.search-box {
  display: flex; align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx; padding: 14rpx 20rpx;
}
.si { margin-right: 10rpx; font-size: 28rpx; }
.sp { color: #bbb; font-size: 26rpx; }
.tabs { display: flex; padding: 8rpx 24rpx 16rpx; background: #fff; }
.tab {
  flex: 1; text-align: center; padding: 14rpx 0;
  font-size: 28rpx; color: #8f7366;
  border-bottom: 3rpx solid transparent;
}
.tab.on { color: #e8927c; border-bottom-color: #e8927c; font-weight: 700; }
.feed {
  padding: 12rpx;
  column-count: 2;
  column-gap: 12rpx;
}
.card {
  break-inside: avoid;
  border-radius: 12rpx; overflow: hidden;
  background: #fff;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.card image { width: 100%; display: block; }
.cinfo { padding: 14rpx 14rpx 16rpx; }
.cdesc {
  font-size: 24rpx; color: #2d1f18; line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.cbot { display: flex; align-items: center; }
.cav-wrap { width: 28rpx; height: 28rpx; border-radius: 50%; overflow: hidden; flex-shrink: 0; margin-right: 6rpx; }
.cav { width: 100%; height: 100%; }
.cname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 20rpx; color: #999; flex: 1; }
.clike { font-size: 20rpx; color: #999; margin-left: 8rpx; white-space: nowrap; flex-shrink: 0; }