.home {
  min-height: 100vh;
  padding: 28rpx 24rpx 34rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fbf6ed 0%, #fffaf4 52%, #f7efe4 100%);
}

.hero {
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.eyebrow {
  display: block;
  color: #e8927c;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}

.title {
  display: block;
  font-family: "Songti SC", serif;
  color: #0b4a3d;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.16;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #8f7366;
  font-size: 25rpx;
  line-height: 1.45;
}

.search-card {
  height: 82rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(140, 104, 83, 0.12);
  box-shadow: 0 18rpx 48rpx rgba(75, 45, 28, 0.08);
}

.search-icon {
  color: #e8927c;
  font-size: 34rpx;
  font-weight: 800;
}

.search-text {
  color: #a58b7d;
  font-size: 26rpx;
}

.tabs {
  display: flex;
  gap: 14rpx;
  margin: 24rpx 0 18rpx;
}

.tab {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8f7366;
  font-size: 26rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.48);
  border: 1rpx solid rgba(140, 104, 83, 0.1);
}

.tab.on {
  color: #fff;
  background: #241912;
  border-color: #241912;
}

.mock-tip {
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  color: #9d7a6b;
  background: rgba(232, 146, 124, 0.1);
  font-size: 23rpx;
}

.feed {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.waterfall-col {
  flex: 1;
  min-width: 0;
}

.video-card {
  width: 100%;
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(140, 104, 83, 0.1);
  box-shadow: 0 18rpx 42rpx rgba(75, 45, 28, 0.08);
  margin-bottom: 18rpx;
}

.cover {
  width: 100%;
  height: 260rpx;
  display: block;
}

.video-card.tall .cover {
  height: 340rpx;
}

.video-card.medium .cover {
  height: 285rpx;
}

.video-card.short .cover {
  height: 210rpx;
}

.card-body {
  padding: 16rpx 16rpx 18rpx;
}

.video-title {
  display: block;
  color: #2d1f18;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.34;
}

.video-desc {
  display: -webkit-box;
  margin-top: 8rpx;
  color: #8f7366;
  font-size: 23rpx;
  line-height: 1.38;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.video-card.tall .video-desc,
.video-card.medium .video-desc {
  -webkit-line-clamp: 3;
}

.meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
}

.avatar {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.author {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9d7a6b;
  font-size: 21rpx;
}

.likes {
  flex-shrink: 0;
  color: #e8927c;
  font-size: 21rpx;
  font-weight: 700;
}
