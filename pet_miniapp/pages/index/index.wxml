<view class="home">
  <view class="hero">
    <view>
      <text class="eyebrow">PETNEST VIDEO</text>
      <text class="title">看看今天的小家伙</text>
      <text class="subtitle">视频 Feed、商品线索和智能客服都在这里。</text>
    </view>
  </view>

  <view class="search-card">
    <text class="search-icon">⌕</text>
    <text class="search-text">搜索视频、宠物、商品或照护问题</text>
  </view>

  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="id" class="tab {{curTab === item.id ? 'on' : ''}}" bindtap="swTab" data-id="{{item.id}}">
      {{item.label}}
    </view>
  </view>

  <view class="mock-tip" wx:if="{{useMock}}">当前使用本地演示数据，后端连通后会自动替换。</view>

  <view class="feed">
    <view class="waterfall-col">
      <view wx:for="{{leftVideos}}" wx:key="id" class="video-card {{item.size}}" bindtap="goDetail" data-id="{{item.id}}">
        <image class="cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
        <view class="card-body">
          <text class="video-title">{{item.title}}</text>
          <text class="video-desc">{{item.desc}}</text>
          <view class="meta">
            <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
            <text class="author">{{item.author}}</text>
            <text class="likes">♥ {{item.likes}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="waterfall-col">
      <view wx:for="{{rightVideos}}" wx:key="id" class="video-card {{item.size}}" bindtap="goDetail" data-id="{{item.id}}">
        <image class="cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
        <view class="card-body">
          <text class="video-title">{{item.title}}</text>
          <text class="video-desc">{{item.desc}}</text>
          <view class="meta">
            <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
            <text class="author">{{item.author}}</text>
            <text class="likes">♥ {{item.likes}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{!loading && !videos.length}}">
    <text>暂无视频</text>
  </view>
</view>
