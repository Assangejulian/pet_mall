.page{padding:20rpx 28rpx 40rpx}.grid{display:flex;flex-wrap:wrap;justify-content:space-between}.vc{width:48.5%;border-radius:14rpx;overflow:hidden;margin-bottom:16rpx;position:relative;background:rgba(255,255,255,.5);border:1rpx solid rgba(140,104,83,.06)}.vi{width:100%;height:300rpx}.vplay{position:absolute;top:110rpx;left:50%;transform:translateX(-50%);width:60rpx;height:60rpx;border-radius:50%;background:rgba(45,31,24,.5);display:flex;align-items:center;justify-content:center}.vplay text{color:#fff;font-size:26rpx;margin-left:4rpx}.vm{padding:14rpx 16rpx 8rpx}.vt{font-size:26rpx;font-weight:600;display:block;margin-bottom:6rpx}.vv{display:flex;gap:14rpx;font-size:22rpx;color:#8f7366}.vp{padding:8rpx 16rpx 14rpx;border-top:1rpx solid rgba(140,104,83,.06)}.vp text{font-size:22rpx;color:#e8927c}
