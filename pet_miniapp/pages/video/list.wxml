<view class="page"><view class="grid"><view wx:for="{{videos}}" wx:key="id" class="vc" bindtap="play" data-id="{{item.id}}"><image class="vi" src="{{item.cover}}" mode="aspectFill" /><view class="vplay"><text>▶</text></view><view class="vm"><text class="vt">{{item.title}}</text><view class="vv"><text>✦ {{item.views}}</text><text>♥ {{item.likes}}</text></view></view><view class="vp" wx:if="{{item.productName}}" catchtap="goP" data-pid="{{item.productId}}"><text>🔗 {{item.productName}}</text></view></view></view><view class="empty-tip" wx:if="{{!videos.length}}"><text>暂无视频</text></view></view>
