.page{display:flex;flex-direction:column;height:100vh;background:#faf7ef}.topbar{display:flex;align-items:center;gap:16rpx;padding:20rpx 28rpx;background:rgba(255,255,255,.8);border-bottom:1rpx solid rgba(140,104,83,.08)}.tb-av{width:64rpx;height:64rpx;border-radius:50%}.tb-name{font-size:30rpx;font-weight:600}.msg-list{flex:1;padding:20rpx 28rpx}.msg{display:flex;margin-bottom:22rpx}.msg.left{justify-content:flex-start}.msg.right{justify-content:flex-end}.bubble{max-width:75%;padding:18rpx 24rpx;border-radius:16rpx;font-size:28rpx;line-height:1.5}.msg.left .bubble{background:#fff;color:#2d1f18;border-top-left-radius:4rpx}.msg.right .bubble{background:#e8927c;color:#fff;border-top-right-radius:4rpx}.input-bar{display:flex;align-items:center;gap:14rpx;padding:16rpx 24rpx;background:#fff;border-top:1rpx solid rgba(140,104,83,.08);padding-bottom:calc(16rpx + env(safe-area-inset-bottom))}.input-bar input{flex:1;height:72rpx;background:rgba(250,247,239,.8);border-radius:36rpx;padding:0 24rpx;font-size:26rpx}.sbtn{color:#e8927c;font-size:28rpx;font-weight:600;padding:0 8rpx}