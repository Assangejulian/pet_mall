<view class="page">
  <view class="store-head" wx:if="{{store}}">
    <image class="store-logo" src="{{store.image}}" mode="aspectFill" wx:if="{{store.image}}" />
    <view class="store-logo placeholder" wx:else><text>店</text></view>
    <view class="store-main">
      <text class="store-name serif">{{store.storeName}}</text>
      <text class="store-address">{{store.address}}</text>
    </view>
  </view>

  <view class="actions" wx:if="{{store}}">
    <button class="action primary" bindtap="navigateToStore">导航到店</button>
    <button class="action" bindtap="callPhone">联系门店</button>
  </view>

  <view class="card" wx:if="{{store.storeDesc}}">
    <text class="section-title serif">门店介绍</text>
    <text class="desc">{{store.storeDesc}}</text>
  </view>

  <view class="card">
    <view class="section-row">
      <text class="section-title serif">在售商品</text>
      <text class="count">{{products.length}} 件</text>
    </view>
    <view class="product" wx:for="{{products}}" wx:key="id" bindtap="goProduct" data-id="{{item.id}}">
      <image class="product-img" src="{{item.image}}" mode="aspectFill" />
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-stock">库存 {{item.stock}}</text>
      </view>
      <text class="price">¥{{item.price}}</text>
    </view>
    <view class="empty" wx:if="{{!loading && !products.length}}"><text>暂无在售商品</text></view>
  </view>
</view>
