.page {
  min-height: 100vh;
  background: #faf7ef;
  padding: 28rpx;
  box-sizing: border-box;
}
.store-head {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 24rpx;
}
.store-logo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: #f0ebe3;
  flex-shrink: 0;
}
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e8927c;
  font-size: 44rpx;
  font-weight: 700;
}
.store-main {
  flex: 1;
  min-width: 0;
}
.store-name {
  display: block;
  font-size: 38rpx;
  color: #3d2e26;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.store-address {
  color: #8f7366;
  font-size: 25rpx;
  line-height: 1.5;
}
.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.action {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  border: none;
  color: #3d2e26;
  background: #f5f0eb;
  font-size: 28rpx;
}
.action::after {
  border: none;
}
.action.primary {
  background: #e8927c;
  color: #fff;
}
.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04);
}
.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 30rpx;
  color: #3d2e26;
  font-weight: 700;
}
.count,
.desc,
.product-stock,
.empty {
  color: #8f7366;
  font-size: 24rpx;
}
.desc {
  line-height: 1.7;
}
.product {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #f5f0eb;
}
.product-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 10rpx;
  background: #f0ebe3;
  flex-shrink: 0;
}
.product-info {
  flex: 1;
  min-width: 0;
}
.product-name {
  display: block;
  color: #3d2e26;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.price {
  color: #e8927c;
  font-size: 28rpx;
  font-weight: 700;
}
.empty {
  text-align: center;
  padding: 36rpx 0 12rpx;
}
