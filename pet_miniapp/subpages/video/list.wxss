.page {
  min-height: 100vh;
  padding: 34rpx 24rpx 44rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fbf6ed 0%, #fffaf4 52%, #f7efe4 100%);
  color: #2d1f18;
}

.hero {
  margin-bottom: 24rpx;
}

.eyebrow {
  display: block;
  color: #e8927c;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}

.title {
  display: block;
  font-family: "Songti SC", serif;
  color: #0b4a3d;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.16;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #8f7366;
  font-size: 25rpx;
  line-height: 1.45;
}

.mock-tip {
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  color: #9d7a6b;
  background: rgba(232, 146, 124, 0.1);
  font-size: 23rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.video-card {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(140, 104, 83, 0.1);
  box-shadow: 0 18rpx 42rpx rgba(75, 45, 28, 0.08);
}

.cover {
  width: 100%;
  height: 300rpx;
  display: block;
  background: #eee1d5;
}

.video-card:nth-child(2n) .cover {
  height: 230rpx;
}

.video-card:nth-child(3n) .cover {
  height: 340rpx;
}

.play-mark {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 4rpx;
  box-sizing: border-box;
  background: rgba(36, 25, 18, 0.72);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}

.body {
  padding: 16rpx 16rpx 18rpx;
}

.video-title {
  display: block;
  color: #2d1f18;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.34;
}

.video-desc {
  display: -webkit-box;
  margin-top: 8rpx;
  color: #8f7366;
  font-size: 23rpx;
  line-height: 1.38;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.meta {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 16rpx;
  color: #9d7a6b;
  font-size: 21rpx;
}

.meta text:first-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta text:last-child {
  flex-shrink: 0;
  color: #e8927c;
  font-weight: 700;
}

.product {
  padding: 12rpx 16rpx 16rpx;
  border-top: 1rpx solid rgba(140, 104, 83, 0.07);
}

.product text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #e8927c;
  font-size: 22rpx;
  font-weight: 700;
}

.empty-tip {
  margin-top: 90rpx;
  text-align: center;
  color: #b7a69a;
  font-size: 25rpx;
}
