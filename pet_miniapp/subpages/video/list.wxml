<view class="page">
  <view class="hero">
    <text class="eyebrow">PETNEST VIDEO</text>
    <text class="title">暖窝视频</text>
    <text class="subtitle">点击视频进入详情页播放，商品线索和客服入口会跟随内容展示。</text>
  </view>

  <view class="mock-tip" wx:if="{{useMock}}">当前使用本地演示数据。</view>

  <view class="grid">
    <view wx:for="{{videos}}" wx:key="id" class="video-card" bindtap="goDetail" data-id="{{item.id}}">
      <image class="cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
      <view class="play-mark">▶</view>
      <view class="body">
        <text class="video-title">{{item.title}}</text>
        <text class="video-desc">{{item.desc}}</text>
        <view class="meta">
          <text>{{item.author}}</text>
          <text>♥ {{item.likes}}</text>
        </view>
      </view>
      <view class="product" wx:if="{{item.productName}}" catchtap="goProduct" data-pid="{{item.productId}}">
        <text>{{item.productName}}</text>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{!loading && !videos.length}}">
    <text>暂无视频</text>
  </view>
</view>
