.page {
  min-height: 100vh;
  padding-bottom: 130rpx;
  background: linear-gradient(180deg, #fbf6ed 0%, #fffaf4 54%, #f7efe4 100%);
  color: #2d1f18;
}

.media-card {
  position: relative;
  height: 620rpx;
  overflow: hidden;
  border-bottom-left-radius: 34rpx;
  border-bottom-right-radius: 34rpx;
  background: #241912;
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
}

.video-player {
  width: 100%;
  height: 100%;
  display: block;
}

.shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(36, 25, 18, 0.08), rgba(36, 25, 18, 0.68));
}

.media-copy {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 34rpx;
}

.eyebrow {
  display: block;
  color: #ffb19e;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
}

.media-title {
  display: block;
  font-family: "Songti SC", serif;
  color: #fff;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.14;
}

.content {
  padding: 24rpx;
}

.mock-tip {
  margin-bottom: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  color: #9d7a6b;
  background: rgba(232, 146, 124, 0.1);
  font-size: 23rpx;
}

.author-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(140, 104, 83, 0.1);
  box-shadow: 0 18rpx 42rpx rgba(75, 45, 28, 0.08);
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.author-info {
  min-width: 0;
  flex: 1;
}

.author {
  display: block;
  font-size: 29rpx;
  font-weight: 800;
}

.desc {
  display: -webkit-box;
  margin-top: 6rpx;
  color: #8f7366;
  font-size: 24rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.follow {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #e8927c;
  border: 1rpx solid rgba(232, 146, 124, 0.7);
  font-size: 24rpx;
  font-weight: 800;
}

.follow.on {
  color: #fff;
  background: #e8927c;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin: 22rpx 0;
}

.action {
  flex: 1;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.64);
  color: #8f7366;
  border: 1rpx solid rgba(140, 104, 83, 0.1);
  font-size: 25rpx;
  font-weight: 750;
}

.action.on {
  color: #e8927c;
}

.link-row {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
  margin-bottom: 26rpx;
}

.product-tag {
  flex: 1;
  min-width: 0;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(232, 146, 124, 0.12);
  border: 1rpx solid rgba(232, 146, 124, 0.18);
}

.tag-label {
  display: block;
  color: #e8927c;
  font-size: 22rpx;
  font-weight: 800;
  margin-bottom: 4rpx;
}

.tag-main {
  display: block;
  color: #2d1f18;
  font-size: 27rpx;
  font-weight: 800;
}

.ai-link {
  width: 148rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #241912;
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
}

.comments {
  padding: 4rpx 0 20rpx;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #2d1f18;
}

.comment {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.comment-avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eee1d5;
}

.comment-body {
  flex: 1;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(140, 104, 83, 0.08);
}

.comment-name { font-size: 26rpx; color: #888; font-weight: 500; }
.comment-header { display: flex; align-items: center; justify-content: space-between; }
.buyer-tag { font-size: 22rpx; color: #e8927c; font-weight: 600; margin-left: 10rpx; background: #fff5f2; padding: 2rpx 8rpx; border-radius: 4rpx; }
.comment-text { font-size: 28rpx; color: #333; margin: 10rpx 0; line-height: 1.5; }

.comment-time {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #b7a69a;
}

.comment-input {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  align-items: center;
  padding: 16rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 250, 244, 0.94);
  border-top: 1rpx solid rgba(140, 104, 83, 0.08);
}

.comment-input input {
  flex: 1;
  height: 76rpx;
  min-width: 0;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(140, 104, 83, 0.14);
  font-size: 27rpx;
}

.send {
  width: 112rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #9d9690;
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
}

.send.active {
  background: #241912;
}
