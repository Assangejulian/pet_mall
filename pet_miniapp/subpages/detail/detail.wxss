.page{padding-bottom:140rpx}.hero-img{position:relative;height:560rpx;overflow:hidden}.hero-img image{width:100%;height:100%}.hero-gradient{position:absolute;inset:0;background:linear-gradient(transparent 45%,rgba(45,31,24,.7))}.hero-caption{position:absolute;bottom:36rpx;left:36rpx}.pet-tag{display:inline-block;padding:6rpx 18rpx;border-radius:20rpx;background:rgba(255,255,255,.85);color:#2d1f18;font-size:22rpx;font-weight:800;margin-bottom:12rpx}.pet-name{display:block;color:#fff;font-size:44rpx;font-weight:700}.price-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:14rpx}.stock{color:#547b68;font-size:24rpx;font-weight:600}.desc{color:#8f7366;font-size:26rpx;line-height:1.7}.sec-title{font-size:30rpx;font-weight:700;display:block;margin-bottom:20rpx;padding-bottom:14rpx;border-bottom:1rpx solid rgba(140,104,83,.1)}.info-row{display:flex;justify-content:space-between;padding:12rpx 0;font-size:26rpx;border-bottom:1rpx solid rgba(140,104,83,.06)}.info-row:last-child{border:none}.lbl{color:#8f7366}.b-bar{position:fixed;bottom:0;left:0;right:0;display:flex;align-items:center;gap:20rpx;padding:18rpx 28rpx;padding-bottom:calc(18rpx + env(safe-area-inset-bottom));background:rgba(250,247,239,.92);border-top:1rpx solid rgba(140,104,83,.08)}.b-cart{position:relative;padding:14rpx;display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx}.b-cart-icon{font-size:48rpx;color:#e8927c}.b-badge{position:absolute;top:2rpx;right:2rpx;min-width:32rpx;height:32rpx;line-height:32rpx;text-align:center;background:#e8927c;color:#fff;font-size:20rpx;border-radius:16rpx;padding:0 6rpx}.btn-outline{flex:1;height:76rpx;line-height:76rpx;text-align:center;border:2rpx solid #e8927c;color:#e8927c;font-size:28rpx;font-weight:700;border-radius:38rpx;background:transparent}.btn-outline::after{border:none}.btn-accent{flex:1;height:76rpx;line-height:76rpx;text-align:center;background:linear-gradient(135deg,#e8927c,#d47a64);color:#fff;font-size:28rpx;font-weight:700;border-radius:38rpx;border:none}.btn-accent::after{border:none}
/* 数量选择弹窗 */
.qty-mask{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:900}
.qty-picker{position:fixed;left:0;right:0;bottom:0;background:#faf7ef;border-radius:24rpx 24rpx 0 0;z-index:901;padding:30rpx 32rpx;padding-bottom:calc(30rpx + env(safe-area-inset-bottom));animation:slideUp .25s ease}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.qty-picker-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx}
.qty-picker-title{font-size:32rpx;font-weight:700;color:#2d1f18}
.qty-picker-close{width:48rpx;height:48rpx;line-height:48rpx;text-align:center;font-size:32rpx;color:#8f7366}
.qty-picker-body{display:flex;gap:20rpx;margin-bottom:28rpx;padding:20rpx;background:#fff;border-radius:16rpx}
.qty-preview-img{width:140rpx;height:140rpx;border-radius:12rpx;flex-shrink:0}
.qty-preview-info{flex:1;display:flex;flex-direction:column;justify-content:center;gap:6rpx}
.qty-preview-name{font-size:28rpx;font-weight:600;color:#2d1f18;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.qty-preview-price{font-size:32rpx;font-weight:700;color:#e8927c}
.qty-preview-stock{font-size:22rpx;color:#8f7366}
.qty-stepper{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:28rpx}
.qty-stepper-btn{width:72rpx;height:72rpx;line-height:72rpx;text-align:center;font-size:36rpx;font-weight:700;color:#2d1f18;background:#fff;border:2rpx solid #e0d6cb}
.qty-stepper-btn:first-child{border-radius:12rpx 0 0 12rpx}
.qty-stepper-btn:last-child{border-radius:0 12rpx 12rpx 0}
.qty-stepper-input{width:120rpx;height:72rpx;line-height:72rpx;text-align:center;font-size:32rpx;font-weight:700;color:#2d1f18;background:#fff;border-top:2rpx solid #e0d6cb;border-bottom:2rpx solid #e0d6cb;border-left:none;border-right:none;padding:0}
.qty-confirm-btn{width:100%;height:80rpx;line-height:80rpx;font-size:30rpx;border-radius:40rpx}
