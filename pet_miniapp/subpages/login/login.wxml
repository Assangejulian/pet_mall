<view class="login-page">
  <view class="login-bg"></view>

  <view class="login-header">
    <view class="login-logo">暖窝</view>
    <text class="login-subtitle">温暖每一个养宠人</text>
  </view>

  <view class="login-card">
    <view class="tab-bar">
      <view wx:for="{{tabs}}" wx:key="id" class="tab-item {{curTab===item.id?'active':''}}" bindtap="swTab" data-id="{{item.id}}">
        <text>{{item.label}}</text>
      </view>
    </view>

    <!-- 密码登录 -->
    <view class="tab-body" wx:if="{{curTab===0}}">
      <view class="input-group">
        <view class="input-row">
          <input class="input-field" type="number" placeholder="手机号" value="{{phone}}" bindinput="onPhoneInput" maxlength="11" />
        </view>
        <view class="input-row">
          <input class="input-field" type="{{showPassword?'text':'password'}}" placeholder="密码" value="{{password}}" bindinput="onPasswordInput" />
          <view class="input-suffix" bindtap="togglePassword">
            <text wx:if="{{showPassword}}">隐藏</text>
            <text wx:else>显示</text>
          </view>
        </view>
      </view>
      <view class="forgot-pwd" bindtap="onForgotPassword"><text>忘记密码?</text></view>
      <view class="agreement">
        <view class="agree-check {{agreed?'checked':''}}" bindtap="toggleAgreed">
          <text wx:if="{{agreed}}" class="agree-check-icon"></text>
        </view>
        <text class="agree-text">登录即代表同意</text>
        <text class="agree-link">《用户协议》</text>
        <text class="agree-text">和</text>
        <text class="agree-link">《隐私政策》</text>
      </view>
      <button class="login-btn" bindtap="onPasswordLogin">登录</button>
    </view>

    <!-- 邮箱登录 -->
    <view class="tab-body" wx:if="{{curTab===1}}">
      <view class="input-group">
        <view class="input-row">
          <input class="input-field" type="text" placeholder="邮箱地址" value="{{email}}" bindinput="onEmailInput" />
        </view>
        <view class="input-row">
          <input class="input-field" type="text" placeholder="验证码" value="{{code}}" bindinput="onCodeInput" maxlength="6" />
          <view class="code-btn {{canSendCode?'':'disabled'}}" bindtap="onSendCode">
            <text wx:if="{{codeCountdown===0}}">获取验证码</text>
            <text wx:else>{{codeCountdown}}s</text>
          </view>
        </view>
      </view>
      <view class="agreement">
        <view class="agree-check {{agreed?'checked':''}}" bindtap="toggleAgreed">
          <text wx:if="{{agreed}}" class="agree-check-icon"></text>
        </view>
        <text class="agree-text">登录即代表同意</text>
        <text class="agree-link">《用户协议》</text>
        <text class="agree-text">和</text>
        <text class="agree-link">《隐私政策》</text>
      </view>
      <button class="login-btn" bindtap="onEmailLogin">登录</button>
    </view>

    <!-- 微信登录 -->
    <view class="tab-body tab-center" wx:if="{{curTab===2}}">
      <view class="social-icon wechat-icon"></view>
      <text class="social-desc">使用微信账号快速登录</text>
      <view class="agreement">
        <view class="agree-check {{agreed?'checked':''}}" bindtap="toggleAgreed">
          <text wx:if="{{agreed}}" class="agree-check-icon"></text>
        </view>
        <text class="agree-text">登录即代表同意</text>
        <text class="agree-link">《用户协议》</text>
        <text class="agree-text">和</text>
        <text class="agree-link">《隐私政策》</text>
      </view>
      <button class="login-btn login-btn--wechat" bindtap="onWechatLogin">微信一键登录</button>
    </view>

    <!-- 人脸登录 -->
    <view class="tab-body tab-center" wx:if="{{curTab===3}}">
      <view class="social-icon face-icon"></view>
      <text class="social-desc">人脸识别 安全便捷</text>
      <view class="agreement">
        <view class="agree-check {{agreed?'checked':''}}" bindtap="toggleAgreed">
          <text wx:if="{{agreed}}" class="agree-check-icon"></text>
        </view>
        <text class="agree-text">登录即代表同意</text>
        <text class="agree-link">《用户协议》</text>
        <text class="agree-text">和</text>
        <text class="agree-link">《隐私政策》</text>
      </view>
      <button class="login-btn login-btn--face" bindtap="onFaceLogin">开始人脸识别</button>
    </view>
  </view>
</view>