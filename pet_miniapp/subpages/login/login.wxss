.login-page{min-height:100vh;background:#fff;padding:0 40rpx 60rpx;display:flex;flex-direction:column}
.login-header{padding:80rpx 0 40rpx;text-align:center}
.login-logo{font-size:52rpx;font-weight:800;color:#e8927c;letter-spacing:6rpx}
.login-subtitle{display:block;margin-top:10rpx;font-size:24rpx;color:#bbb}

.tab-bar{display:flex;border-bottom:1rpx solid #f0f0f0;margin-bottom:36rpx}
.tab-item{flex:1;text-align:center;padding:22rpx 0 18rpx;position:relative}
.tab-item text{font-size:28rpx;color:#999}
.tab-item.active text{color:#2d1f18;font-weight:700}
.tab-item.active::after{content:"";position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:40rpx;height:5rpx;border-radius:3rpx;background:#e8927c}

.tab-body{flex:1}
.tab-center{display:flex;flex-direction:column;align-items:center;padding-top:50rpx}

.input-group{margin-top:8rpx}
.input-row{display:flex;align-items:center;background:#f5f5f5;border-radius:14rpx;padding:0 22rpx;margin-bottom:22rpx;height:92rpx}
.input-prefix{font-size:28rpx;color:#333;font-weight:600;margin-right:14rpx;padding-right:14rpx;border-right:1rpx solid #e0e0e0;flex-shrink:0}
.input-field{flex:1;font-size:28rpx;color:#2d1f18}
.input-suffix{padding:8rpx;flex-shrink:0}
.input-suffix text{font-size:34rpx}
.sms-input{flex:1}
.sms-btn{flex-shrink:0;width:170rpx;text-align:center;font-size:24rpx;color:#e8927c;font-weight:600;padding:8rpx 0;border-left:1rpx solid #e0e0e0}
.sms-btn.disabled{color:#bbb}

.forgot-pwd{text-align:right;margin-bottom:10rpx;margin-top:-6rpx}
.forgot-pwd text{font-size:24rpx;color:#999}

.agreement{display:flex;align-items:center;justify-content:center;margin:16rpx 0 24rpx;flex-wrap:wrap}
.agree-check{width:30rpx;height:30rpx;border:2rpx solid #ccc;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-right:8rpx;font-size:18rpx;color:#fff;flex-shrink:0}
.agree-check.checked{background:#e8927c;border-color:#e8927c}
.agree-text{font-size:22rpx;color:#999}
.agree-link{font-size:22rpx;color:#e8927c}

.login-btn-wrap{margin-top:0}
.login-btn{width:100%;height:92rpx;line-height:92rpx;background:#e8927c;color:#fff;font-size:32rpx;font-weight:700;border-radius:46rpx;border:none;box-shadow:0 6rpx 20rpx rgba(232,146,124,.3)}
.login-btn::after{border:none}
.wx-btn{background:#07c160;box-shadow:0 6rpx 20rpx rgba(7,193,96,.3)}
.face-btn{background:#5b8def;box-shadow:0 6rpx 20rpx rgba(91,141,239,.3)}

.wx-icon-wrap,.face-icon-wrap{margin:20rpx 0 16rpx}
.wx-icon,.face-icon{width:110rpx;height:110rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:52rpx}
.wx-icon{background:#07c160}
.face-icon{background:#5b8def}
.wx-desc,.face-desc{font-size:24rpx;color:#999;margin-bottom:0}

.other-login{margin-top:60rpx}
.divider{display:flex;align-items:center}
.divider-line{flex:1;height:1rpx;background:#eee}
.divider-text{padding:0 22rpx;font-size:22rpx;color:#bbb}
.other-icons{display:flex;justify-content:center;gap:56rpx;margin-top:32rpx}
.other-item{display:flex;flex-direction:column;align-items:center;gap:8rpx}
.other-icon{font-size:48rpx}
.other-label{font-size:20rpx;color:#999}