/* ===== C-side palette ===== */
page {
  --ink: #2d1f18;
  --muted: #8f7366;
  --paper: #faf7ef;
  --card: rgba(255,255,255,0.7);
  --line: rgba(140,104,83,0.18);
  --accent: #e8927c;
  --accent-2: #f5c8b8;
  --dark: #211813;
  --green: #547b68;
  --shadow: 0 24px 70px rgba(64,43,28,0.13);
  background: var(--paper);
}

.login-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  background:
    radial-gradient(ellipse at 20% 10%, rgba(232,146,124,0.10), transparent 50%),
    radial-gradient(ellipse at 80% 30%, rgba(245,200,184,0.08), transparent 40%),
    linear-gradient(180deg, #fffaf4, var(--paper));
}

.login-header {
  padding: 0 0 40rpx;
  text-align: center;
}

.login-logo {
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 8rpx;
}

.login-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

/* ===== Card ===== */
.login-card {
  width: 100%;
  max-width: 600rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 36rpx 36rpx 44rpx;
  backdrop-filter: blur(12rpx);
  box-shadow: var(--shadow);
}

/* ===== Tabs ===== */
.tab-bar {
  display: flex;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 40rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0 18rpx;
  position: relative;
}

.tab-item text {
  font-size: 26rpx;
  color: var(--muted);
  font-weight: 500;
}

.tab-item.active text {
  color: var(--ink);
  font-weight: 700;
}

.tab-item.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--accent);
}

.tab-body {
  flex: 1;
}

.tab-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 20rpx;
}

/* ===== Inputs ===== */
.input-group {
  margin-bottom: 8rpx;
}

.input-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: rgba(255,255,255,0.72);
  transition: border-color 200ms ease, background 200ms ease;
}

.input-row:focus-within {
  border-color: var(--accent);
  background: #fff;
}

.input-field {
  flex: 1;
  height: 92rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: transparent;
  border: none;
  outline: none;
}

.input-field::placeholder {
  color: #bfafa5;
}

.input-suffix {
  flex-shrink: 0;
  padding: 8rpx 0 8rpx 20rpx;
  border-left: 1rpx solid var(--line);
}

.input-suffix text {
  font-size: 24rpx;
  color: var(--muted);
  font-weight: 600;
}

.code-btn {
  flex-shrink: 0;
  width: 170rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 700;
  padding: 8rpx 0;
  border-left: 1rpx solid var(--line);
}

.code-btn.disabled {
  color: #bfafa5;
}

/* ===== Forgot password ===== */
.forgot-pwd {
  text-align: right;
  margin-bottom: 8rpx;
  margin-top: -8rpx;
}

.forgot-pwd text {
  font-size: 24rpx;
  color: var(--muted);
}

/* ===== Agreement ===== */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 32rpx;
  flex-wrap: wrap;
}

.agree-check {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #d5c8be;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  flex-shrink: 0;
  transition: background 180ms ease, border-color 180ms ease;
}

.agree-check.checked {
  background: var(--accent);
  border-color: var(--accent);
}

.agree-check-icon {
  display: block;
  width: 10rpx;
  height: 16rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
  margin-top: -3rpx;
}

.agree-text {
  font-size: 22rpx;
  color: var(--muted);
}

.agree-link {
  font-size: 22rpx;
  color: var(--ink);
  font-weight: 600;
}

/* ===== Buttons ===== */
.login-btn {
  width: 100%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: var(--accent);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(232,146,124,0.25);
  transition: opacity 160ms ease, transform 160ms ease;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  opacity: 0.82;
  transform: scale(0.97);
}

.login-btn--wechat {
  background: #07c160;
  box-shadow: 0 4rpx 16rpx rgba(7,193,96,0.20);
}

.login-btn--face {
  background: #5b8def;
  box-shadow: 0 4rpx 16rpx rgba(91,141,239,0.20);
}

/* ===== Social icons (CSS-only) ===== */
.social-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 16rpx 0 24rpx;
}

.wechat-icon {
  background: #07c160;
  position: relative;
}

.wechat-icon::before {
  content: "";
  display: block;
  width: 36rpx;
  height: 28rpx;
  border: 3rpx solid #fff;
  border-radius: 4rpx;
  border-top: none;
}

.wechat-icon::after {
  content: "";
  display: block;
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: #07c160;
  border: 3rpx solid #fff;
  border-radius: 50%;
  border-bottom-color: transparent;
  border-right-color: transparent;
  transform: rotate(135deg);
  margin-top: -16rpx;
  margin-left: -6rpx;
}

.face-icon {
  background: #5b8def;
  position: relative;
}

.face-icon::before {
  content: "";
  display: block;
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
}

.face-icon::after {
  content: "";
  display: block;
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow:
    16rpx 0 0 0 #fff,
    0 16rpx 0 0 #fff,
    16rpx 16rpx 0 0 #fff;
  margin-top: -38rpx;
  margin-left: 13rpx;
}

.social-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}