<view class="page">
  <view class="section-title">{{selecting ? '选择收货地址' : '我的收货地址'}}</view>

  <view class="card" wx:for="{{list}}" wx:key="id" bindtap="selectAddress" data-index="{{index}}">
    <view class="at">
      <text class="an">{{item.receiverName}}</text>
      <text class="ap">{{item.phone}}</text>
      <text class="adef" wx:if="{{item.defaulted}}">默认</text>
    </view>
    <text class="aa">{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</text>
    <view class="a-actions" wx:if="{{!selecting}}">
      <text class="a-btn" catchtap="setDefault" data-id="{{item.id}}">设为默认</text>
      <text class="a-btn del" catchtap="delAddr" data-id="{{item.id}}">删除</text>
    </view>
  </view>
  <view class="empty-tip" wx:if="{{!list.length && !loading}}"><text>还没有收货地址，请在下方添加</text></view>

  <view class="form-card">
    <view class="form-title">添加新地址</view>
    <view class="form-row">
      <text class="label">收件人</text>
      <input class="input" placeholder="请输入收件人姓名" value="{{form.receiverName}}" bindinput="onInput" data-field="receiverName" />
    </view>
    <view class="form-row">
      <text class="label">手机号</text>
      <input class="input" placeholder="请输入手机号" type="number" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
    </view>
    <view class="form-row">
      <text class="label">省份</text>
      <input class="input" placeholder="如：广东省" value="{{form.province}}" bindinput="onInput" data-field="province" />
    </view>
    <view class="form-row">
      <text class="label">城市</text>
      <input class="input" placeholder="如：深圳市" value="{{form.city}}" bindinput="onInput" data-field="city" />
    </view>
    <view class="form-row">
      <text class="label">区县</text>
      <input class="input" placeholder="如：南山区" value="{{form.district}}" bindinput="onInput" data-field="district" />
    </view>
    <view class="form-row">
      <text class="label">详细地址</text>
      <input class="input" placeholder="如：科技园路1号" value="{{form.detail}}" bindinput="onInput" data-field="detail" />
    </view>
    <view class="form-row default-row">
      <text class="label">设为默认</text>
      <switch checked="{{form.defaulted}}" bindchange="onDefaultChange" color="#e8927c" />
    </view>
    <view class="btn-add" bindtap="addAddr">保存地址</view>
  </view>
</view>
