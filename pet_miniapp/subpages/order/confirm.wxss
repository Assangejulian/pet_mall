.page { padding: 12px; padding-bottom: 80px; background: #f5f5f5; min-height: 100vh; }
.section { background: #fff; border-radius: 10px; padding: 14px; margin-bottom: 10px; }
.st { font-size: 14px; font-weight: 600; color: #333; margin-bottom: 8px; display: block; }
.addr { font-size: 13px; color: #666; line-height: 1.6; white-space: pre-line; }
.placeholder { color: #e8927c; }
.item { display: flex; gap: 10px; padding: 8px 0; }
.img { width: 60px; height: 60px; border-radius: 6px; background: #f0f0f0; }
.info { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.nm { font-size: 14px; color: #333; }
.price { font-size: 13px; color: #e8927c; margin-top: 4px; }
.remark-input { border: 1px solid #eee; border-radius: 6px; padding: 8px 10px; font-size: 13px; width: 100%; box-sizing: border-box; }
.b-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #eee; }
.total { font-size: 14px; color: #333; }
.total .price { font-size: 18px; color: #e8927c; font-weight: 700; }
.btn-primary { background: #e8927c; color: #fff; border: none; border-radius: 20px; padding: 10px 24px; font-size: 14px; }
