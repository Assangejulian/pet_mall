<view class="page">
  <view class="order-header" wx:if="{{order}}">
    <text class="order-no">订单号: {{order.orderNo}}</text>
    <text class="order-status {{'s' + order.orderStatus}}">{{statusLabels[order.orderStatus]}}</text>
  </view>

  <!-- 状态提示 -->
  <view class="status-hint" wx:if="{{order.orderStatus === 1}}">
    <text class="hint-icon">⏳</text>
    <view class="hint-text">
      <text class="hint-title">已支付，等待商家发货</text>
      <text class="hint-desc">商家将尽快为你安排发货，请耐心等待</text>
    </view>
  </view>

  <!-- 物流/时间线 -->
  <view class="timeline-card" wx:if="{{order}}">
    <view class="tl-row"><text class="tl-label">下单时间</text><text class="tl-value">{{order.createTime}}</text></view>
    <view class="tl-row" wx:if="{{order.payTime}}"><text class="tl-label">支付时间</text><text class="tl-value">{{order.payTime}}</text></view>
    <view class="tl-row" wx:if="{{order.shipTime}}"><text class="tl-label">发货时间</text><text class="tl-value">{{order.shipTime}}</text></view>
    <view class="tl-row" wx:if="{{order.logisticsCarrier}}"><text class="tl-label">物流公司</text><text class="tl-value">{{order.logisticsCarrier}}</text></view>
    <view class="tl-row" wx:if="{{order.logisticsNo}}"><text class="tl-label">物流单号</text><text class="tl-value">{{order.logisticsNo}}</text></view>
    <view class="tl-row" wx:if="{{order.receiveTime}}"><text class="tl-label">收货时间</text><text class="tl-value">{{order.receiveTime}}</text></view>
    <view class="tl-row" wx:if="{{order.cancelReason}}"><text class="tl-label">取消原因</text><text class="tl-value warn">{{order.cancelReason}}</text></view>
  </view>

  <!-- 商品列表 -->
  <view class="items-card" wx:if="{{items.length}}">
    <text class="sec-title">商品信息</text>
    <view class="item-row" wx:for="{{items}}" wx:key="id">
      <image class="item-img" src="{{item.productImage}}" mode="aspectFill" />
      <view class="item-info">
        <text class="item-name">{{item.productName}}</text>
        <text class="item-price">¥{{item.price}}</text>
        <text class="item-qty">x{{item.quantity}}</text>
      </view>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="address-card" wx:if="{{addressParsed}}">
    <text class="sec-title">收货地址</text>
    <text class="addr-name">{{addressParsed.receiverName}}  {{addressParsed.phone}}</text>
    <text class="addr-detail">{{addressText}}</text>
  </view>
  <!-- 金额 -->
  <view class="amount-card" wx:if="{{order}}">
    <view class="amt-row"><text>商品金额</text><text>¥{{order.totalAmount}}</text></view>

    <view class="amt-row"><text>优惠</text><text>-¥{{order.discountAmount || '0.00'}}</text></view>
    <view class="amt-row total"><text>实付</text><text>¥{{order.payAmount}}</text></view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar" wx:if="{{order}}">
    <button class="btn-primary" bindtap="payOrder" wx:if="{{order.orderStatus == 0}}">去支付</button>
    <button class="btn-outline" bindtap="directRefund" wx:if="{{order.orderStatus == 1}}">极速退款</button>
    <button class="btn-primary" bindtap="confirmReceive" wx:if="{{order.orderStatus == 2}}">确认收货</button>
    <button class="btn-primary" bindtap="evaluateOrder" wx:if="{{order.orderStatus == 3}}">去评价</button>
    <button class="btn-outline" bindtap="applyRefund" wx:if="{{order.orderStatus == 3}}">退款</button>
    <button class="btn-outline" bindtap="applyRefund" wx:if="{{order.orderStatus == 4}}">退款</button>
    <button class="btn-outline" bindtap="callService">联系客服</button>
  </view>

  <view class="empty-tip" wx:if="{{!loading && !order}}">订单不存在</view>
</view>
