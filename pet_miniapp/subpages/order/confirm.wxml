<view class="page">
  <view class="section" bindtap="selectAddress">
    <text class="st">收货地址</text>
    <text class="addr" wx:if="{{address}}">{{address.receiverName}} {{address.phone}}\n{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</text>
    <text class="addr placeholder" wx:else>请选择收货地址</text>
  </view>

  <view class="section">
    <text class="st">商品信息</text>
    <view class="item" wx:for="{{items}}" wx:key="id">
      <image class="img" src="{{item.image}}" mode="aspectFill" />
      <view class="info">
        <text class="nm">{{item.name}}</text>
        <text class="price">¥{{item.price}} x {{item.quantity}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="st">订单备注</text>
    <input class="remark-input" placeholder="选填，备注信息" bindinput="onRemarkInput" />
  </view>

  <view class="b-bar">
    <text class="total">合计: <text class="price">¥{{total}}</text></text>
    <button class="btn-primary" bindtap="submitOrder">提交订单</button>
  </view>
</view>
