<view class="page">
  <view class="amount-section">
    <view class="amount-title">鏀粯閲戦</view>
    <view class="amount-value"><text class="symbol">楼</text>{{amount}}</view>
    <view class="order-no">璁㈠崟鍙凤細{{orderNo}}</view>
  </view>

  <view class="method-section">
    <view class="section-title">閫夋嫨鏀粯鏂瑰紡</view>

    <view class="method-item" bindtap="selectMethod" data-method="wechat">
      <view class="method-left">
        <text class="method-icon wechat">W</text>
        <text class="method-name">寰俊鏀粯</text>
      </view>
      <view class="method-right">
        <view class="radio {{payMethod === 'wechat' ? 'checked' : ''}}"></view>
      </view>
    </view>

    <view class="method-item" bindtap="selectMethod" data-method="balance">
      <view class="method-left">
        <text class="method-icon balance">B</text>
        <text class="method-name">浣欓鏀粯</text>
        <text class="method-desc">(妯℃嫙)</text>
      </view>
      <view class="method-right">
        <view class="radio {{payMethod === 'balance' ? 'checked' : ''}}"></view>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="btn-pay" bindtap="confirmPay">纭鏀粯 楼{{amount}}</view>
  </view>
</view>
