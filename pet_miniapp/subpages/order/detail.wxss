.page{padding:20rpx 28rpx 120rpx}.sb{display:flex;align-items:center;gap:18rpx;padding:28rpx 24rpx;border-radius:14rpx;margin-bottom:20rpx}.si{font-size:50rpx}.st{font-size:32rpx;font-weight:700;display:block}.ct{font-size:26rpx;font-weight:700;display:block;margin-bottom:14rpx}.ad{font-size:26rpx;color:#8f7366;line-height:1.6}.oit{display:flex;align-items:center;gap:14rpx;padding:12rpx 0}.oimg{width:90rpx;height:90rpx;border-radius:8rpx}.oinfo{flex:1}.oinm{font-size:26rpx;display:block}.oiq{font-size:22rpx;color:#8f7366}.oip{font-size:26rpx;font-weight:600}.pr{display:flex;justify-content:space-between;padding:10rpx 0;font-size:26rpx}

/* 按钮底栏 */
.bottom-bar{position:fixed;bottom:0;left:0;right:0;padding:16rpx 28rpx 40rpx;background:#fff;box-shadow:0 -2rpx 8rpx rgba(0,0,0,.06);display:flex;gap:16rpx}
.btn-primary{flex:1;height:80rpx;line-height:80rpx;text-align:center;font-size:28rpx;border-radius:12rpx;background:linear-gradient(135deg,#e8927c,#d47a64);color:#fff;border:none}
.btn-primary::after{border:none}
.btn-outline{flex:1;height:80rpx;line-height:80rpx;text-align:center;font-size:28rpx;border-radius:12rpx;background:#fff;color:#e8927c;border:2rpx solid #e8927c}

/* 状态提示 */
.status-hint{display:flex;align-items:center;gap:16rpx;margin-bottom:20rpx;padding:20rpx 24rpx;background:linear-gradient(135deg,#e8f4fd,#d0eafc);border-radius:14rpx}
.hint-icon{font-size:48rpx;flex-shrink:0}
.hint-text{flex:1}
.hint-title{display:block;font-size:28rpx;font-weight:600;color:#1565c0;margin-bottom:4rpx}
.hint-desc{display:block;font-size:22rpx;color:#5a8ab5}
