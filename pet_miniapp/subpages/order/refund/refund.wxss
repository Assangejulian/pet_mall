.page {
  padding: 30rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}

.refund-form {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  display: block;
}

.form-group {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}

.reason-input {
  width: 100%;
  height: 240rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-btn {
  background-color: #e65100;
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
}
.submit-btn[disabled] {
  background-color: #ccc;
  color: #fff;
}
