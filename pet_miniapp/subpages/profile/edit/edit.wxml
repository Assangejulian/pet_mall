<view class="page">
  <view class="form">
    <view class="field">
      <text class="label">头像</text>
      <view class="avatar-row">
        <view class="avatar" bindtap="chooseAvatar">{{avatarText}}</view>
        <text class="hint">点击更换</text>
      </view>
    </view>
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" value="{{username}}" disabled placeholder="用户名不可修改" />
    </view>
    <view class="field">
      <text class="label">真实姓名</text>
      <input class="input" value="{{realName}}" placeholder="请输入真实姓名" bindinput="onInput" data-field="realName" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" value="{{phone}}" type="tel" maxlength="11" placeholder="请输入手机号" bindinput="onInput" data-field="phone" />
    </view>
    <view class="field">
      <text class="label">邮箱</text>
      <input class="input" value="{{email}}" type="text" placeholder="请输入邮箱" bindinput="onInput" data-field="email" />
    </view>
    <view class="field">
      <text class="label">生日</text>
      <picker mode="date" value="{{birthday}}" bindchange="onBirthdayChange">
        <view class="input picker-value">{{birthday || '请选择生日'}}</view>
      </picker>
    </view>
  </view>

  <view class="actions">
    <button class="btn-save" bindtap="saveProfile" loading="{{saving}}">保存</button>
    <button class="btn-cancel" bindtap="goBack">取消</button>
  </view>
</view>
